# Server
PORT=8080
AGENTS_DIR=packages/server/agents

# Real LLM provider verification.
# This server currently expects an OpenAI-compatible endpoint.
# You can use either the generic LLM_* names or the gateway aliases.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=replace_with_real_key
# LLM_GATEWAY_URL=https://gateway.example.com/v1
# LLM_GATEWAY_MODEL=model-name
# LLM_GATEWAY_API_KEY=replace_with_gateway_key

# API auth. Use one or more comma-separated bearer tokens.
API_AUTH_TOKENS=replace_with_test_token

# Session service defaults
SESSION_TTL_MS=1800000
MAX_SESSIONS=100
SESSION_STORE_BACKEND=memory

# Required when SESSION_STORE_BACKEND=postgres
POSTGRES_URL=

# Request/security controls
CORS_ALLOWED_ORIGINS=*
MAX_REQUEST_BYTES=1000000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Runtime reliability controls
TURN_TIMEOUT_MS=45000
LLM_CIRCUIT_FAILURES=5
LLM_CIRCUIT_OPEN_MS=60000

# Optional JSON object of headers used for http/https tool calls
TOOL_HTTP_HEADERS_JSON=
