{
  "name": "@agentscript/runtime-vercel",
  "version": "0.1.0",
  "description": "Vercel AI SDK adapter for @agentscript/runtime.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "development": {
        "types": "./src/index.ts",
        "import": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "example": "tsx examples/run-mock.ts"
  },
  "dependencies": {
    "@agentscript/agentforce": "workspace:*",
    "@agentscript/compiler": "workspace:*",
    "@agentscript/runtime": "workspace:*"
  },
  "peerDependencies": {
    "ai": ">=4.0.0"
  },
  "devDependencies": {
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "vitest": "^3.0.0"
  },
  "author": {
    "name": "AgentScript Team",
    "email": "agentscript@salesforce.com"
  },
  "license": "MIT"
}
