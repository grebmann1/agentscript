{
  "name": "@agentscript/cli",
  "version": "0.1.0",
  "description": "AgentScript CLI — turn a .agent file into a deployable bundle.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "agentscript": "./dist/index.js"
  },
  "exports": {
    ".": {
      "development": {
        "types": "./src/index.ts",
        "import": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./build": {
      "development": {
        "types": "./src/commands/build.ts",
        "import": "./src/commands/build.ts"
      },
      "types": "./dist/commands/build.d.ts",
      "import": "./dist/commands/build.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc && node scripts/copy-template.mjs",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@agentscript/compiler": "workspace:*",
    "@agentscript/runtime-vercel": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.19.37",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0"
  },
  "license": "Apache-2.0"
}
